<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<LangVersion>9.0</LangVersion>
		<RootNamespace>Noppes.E621</RootNamespace>
		<AssemblyName>Noppes.E621Client</AssemblyName>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<Authors>NoppesTheFolf and contributors</Authors>
		<Version>0.12.0</Version>
		<Description>.NET Standard wrapper for the e621 API.</Description>
		<PackageProjectUrl>https://github.com/NoppesTheFolf/E621Client</PackageProjectUrl>
		<RepositoryUrl>https://github.com/NoppesTheFolf/E621Client</RepositoryUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Product>E621Client</Product>
		<PackageIcon>E621Client.png</PackageIcon>
		<Copyright>Copyright © NoppesTheFolf and contributors</Copyright>
		<PackageReleaseNotes>- Database exports can now be retrieved directly through the client using the new GetDbExportsAsync and GetDbExportStreamAsync methods. Reading the actual CSV files is still part of the Noppes.E621Client.DbExport package.
- Removed the TagHelper class. Tags passed to GetPostsAsync are no longer parsed and the limit of 40 tags is no longer enforced by the library.
- E621Client is now sealed and its protected Dispose(bool) method has been removed.
- NuGet dependencies have been upgraded to their latest versions.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Dawn.Guard" Version="1.12.0" />
		<PackageReference Include="Flurl.Http" Version="4.0.2" />
		<PackageReference Include="Flurl.Http.Newtonsoft" Version="0.9.1" />
	</ItemGroup>

	<ItemGroup>
		<None Include="E621Client.png">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
	</ItemGroup>

</Project>
